@page "/"
@using FoodBazaar.Repository
@inject IProductRepository ProductRepository
@inject ICategoryRepository CategoryRepository

<PageTitle>FoodBazaar | Menu</PageTitle>

<style>
    .menu-page {
        max-width: 76rem;
        margin-inline: auto;
    }

        .menu-page .menu-hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow: hidden;
            border-radius: 1.25rem;
            background: #203c32;
            color: #fffaf0;
        }

        .menu-page .hero-copy {
            align-self: center;
            padding: clamp(1.5rem, 5vw, 4.5rem);
        }

            .menu-page .hero-copy h1,
            .menu-page .menu-section h2 {
                font-family: Georgia, serif;
                letter-spacing: -0.035em;
            }

            .menu-page .hero-copy h1 {
                font-size: clamp(2.5rem, 6vw, 5rem);
                line-height: 1;
            }

            .menu-page .hero-copy p {
                margin-block: 1rem 1.5rem;
                color: #e4eadd;
            }

        .menu-page .hero-image {
            display: block;
            width: 100%;
            height: 100%;
            max-height: 27rem;
            object-fit: cover;
        }

        .menu-page .menu-section {
            padding-block: clamp(2rem, 5vw, 4rem);
        }

        .menu-page .menu-filters,
        .menu-page .menu-empty {
            padding: 1rem;
            border: 1px solid #e6e3d9;
            border-radius: 0.875rem;
            background: #f8f6ef;
        }

        .menu-page .menu-filters {
            margin-inline: 0;
            padding-top: 0;
        }

        .menu-page .menu-card {
            overflow: hidden;
            border: 1px solid #e6e3d9;
            border-radius: 0.875rem;
            box-shadow: 0 0.25rem 0.75rem rgb(32 60 50 / 7%);
        }

        .menu-page .menu-image {
            aspect-ratio: 16 / 9;
            object-fit: cover;
        }

        .menu-page .menu-price {
            padding: 0.3rem 0.65rem;
            border-radius: 0.5rem;
            background: #eaf0e8;
            color: #203c32;
            font-variant-numeric: tabular-nums;
        }

    @@media (max-width: 575.98px) {
        .menu-page .menu-hero {
            grid-template-columns: 1fr;
        }

        .menu-page .hero-image {
            max-height: 13rem;
        }
    }
</style>

<div class="menu-page">
    <section class="menu-hero" aria-labelledby="menu-hero-title">
        <div class="hero-copy">
            <h1 id="menu-hero-title">FoodBazaar</h1>
            <p>Browse our appetizers, mains, and desserts.</p>
            <a href="#menu" class="btn btn-light">View menu</a>
        </div>
        <img class="hero-image" src="images/product/demo/appetizers.png"
             alt="Tomato and basil bruschetta" width="1536" height="1024" />
    </section>

    <section id="menu" class="menu-section" aria-labelledby="menu-title">
        <header class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
            <h2 id="menu-title" class="mb-0">Our Menu</h2>
            <span class="text-body-secondary" aria-live="polite">@TotalCount items</span>
        </header>

        <div class="menu-filters row g-3 mb-4">
            <div class="col-sm">
                <label for="category" class="form-label">Category</label>
                <InputSelect id="category" class="form-select" @bind-Value="SelectedCategory" @bind-Value:after="OnFiltersChanged">
                    <option value="0">All Categories</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-sm">
                <label for="ProductName" class="form-label">Product Name</label>
                <input id="ProductName" type="search" class="form-control" @bind="SearchString"
                    @bind:event="oninput" @bind:after="OnFiltersChanged" />

            </div>
            <div class="col-sm-auto">
                <label for="products" class="form-label">Items per page</label>
                <InputSelect id="products" class="form-select" @bind-Value="PageSize" @bind-Value:after="OnFiltersChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </InputSelect>

            </div>
        </div>

        @if (!FilteredProducts.Any())
        {
            <p class="menu-empty mb-0">No products available.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">
                @foreach (var item in FilteredProducts)
                {
                    <div class="col">
                        <article class="card menu-card h-100">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name"
                                     class="card-img-top menu-image" loading="lazy" />
                            }

                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <h3 class="card-title h5">@item.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="card-text text-body-secondary">@item.Description</p>
                                }
                                <strong class="menu-price mt-auto align-self-start">€@item.Price.ToString("0.00")</strong>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <nav class="menu-pagination d-flex flex-wrap align-items-center justify-content-center gap-3 mt-4"
                 aria-label="Menu pages">
                <button type="button" class="btn btn-outline-success"
                        disabled="@(CurrentPage <= 1)" @onclick="PreviousPage">
                    <span class="bi bi-arrow-left me-1" aria-hidden="true"></span> Previous
                </button>
                <span class="small fw-semibold" aria-live="polite">Page @CurrentPage of @TotalPage</span>
                <button type="button" class="btn btn-outline-success"
                        disabled="@(CurrentPage >= TotalPage)" @onclick="NextPage">
                    Next <span class="bi bi-arrow-right ms-1" aria-hidden="true"></span>
                </button>
            </nav>
        }
    </section>
</div>

@code {
    public IEnumerable<Product> FilteredProducts { get; set; } = new List<Product>();
    public IEnumerable<Category> Categories { get; set; } = new List<Category>();
    public int SelectedCategory { get; set; } = 0;
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; } = 0;
    private int TotalPage { get; set; } = 1;
    private string SearchString = "";

    protected override async Task OnInitializedAsync()
    {
        Categories = await CategoryRepository.GetAllAsync();
        await FilterProducts();
    }

    private async Task FilterProducts()
    {
        var (items, totalCount) = await ProductRepository.GetProductsByCategoryAsync
           (searchString: SearchString, categoryId: SelectedCategory, pageNumber: CurrentPage, pageSize: PageSize);
        FilteredProducts = items;
        TotalCount = totalCount;
        TotalPage = (int)Math.Ceiling((double)TotalCount / PageSize);


    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPage)
        {
            CurrentPage++;
            await FilterProducts();
        }
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await FilterProducts();
        }
    }

    private async Task OnFiltersChanged()
    {
        CurrentPage = 1; // Reset to the first page when filters change
        await FilterProducts();
    }
}