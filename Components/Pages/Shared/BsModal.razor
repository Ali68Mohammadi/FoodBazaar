<!-- Modal -->
<div class="modal fade" id="@Id" tabindex="-1" aria-labelledby="@(Id + "-title")" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="@(Id + "-title")">@Title</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <button type="button" class="btn btn-lg btn-secondary" data-bs-dismiss="modal"
                        @onclick="() => ConfirmationClicked(false)" style="width: 150px;">
                    Close
                </button>
                @if (ConfirmContent is null)
                {
                    <button type="button" class="btn btn-lg @ButtonBootstrapStyle"
                            @onclick="() => ConfirmationClicked(true)">
                        @ButtonText
                    </button>
                }
                else
                {
                    @ConfirmContent
                }
            </div>
            <div class="modal-footer">
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "bsConfirmationModal";

    [Parameter]
    public RenderFragment? ConfirmContent { get; set; }

    [Parameter]
    public EventCallback<bool> OnModalConfirmation { get; set; }

    [Parameter]
    public string Title { get; set; } = "plese confirm";

    [Parameter]
    public string ButtonBootstrapStyle { get; set; } = "btn-primary";

    [Parameter]
    public string ButtonText { get; set; } = "confirm";



    private async Task ConfirmationClicked(bool value)
    {
        if (value)
        {
            await OnModalConfirmation.InvokeAsync(value);
        }

    }
}

